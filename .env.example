# Break duration after max messages (in minutes)
SESSION_BREAK_MIN=20

# Your business name (used in AI prompts)
BUSINESS_NAME=Diwan Electronics

# Your WhatsApp number (for testing - messages sent here first)
TEST_PHONE=
